# =================================================================
# SHIV SHAKTI HP GAS ERP - ENVIRONMENT CONFIGURATION
# Copy this file to .env or configure these variables in Vercel:
# Settings -> Environment Variables
# =================================================================

# OPTION 1: Using Supabase Connection String (Recommended)
# From Supabase: Project Settings -> Database -> Connection Pooling -> Connection String (Transaction or Session mode)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# OPTION 2: Individual Database Connection Variables
# DB_DRIVER=pgsql
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=postgres.yourprojectref
# DB_PASS=yourpassword
# DB_SSLMODE=require

# Application Environment
APP_ENV=production
APP_NAME="Shiv Shakti HP Gas ERP"
