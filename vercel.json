{
  "version": 2,
  "regions": ["syd1"],
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{controllers/**,config.php,db.php,auth.php,api.php}"
    }
  },
  "routes": [
    { "src": "/api.php", "dest": "/api/index.php" },
    { "src": "/api", "dest": "/api/index.php" },
    { "src": "/api/(.*)", "dest": "/api/index.php" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
